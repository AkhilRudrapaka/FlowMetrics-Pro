# =====================================================================================
#  FlowMetrics Pro: configuration for `docker compose`.
#
#  Quick start:   cp .env.example .env      (Windows PowerShell:  Copy-Item .env.example .env)
#                 docker compose up --build
#
#  Every value below is for LOCAL DEVELOPMENT / DEMO ONLY. The file is safe to commit because it
#  contains no real secrets; your copy (.env) is git-ignored. Anything deployed must replace
#  the passwords and JWT secret and set APP_ENV=production.
# =====================================================================================

# ---- MongoDB ----------------------------------------------------------------------
# Root account, created the first time the database volume starts.
# Keep the password to letters, digits and dashes: it is embedded in the connection URL.
MONGO_ROOT_USER=flowmetrics
MONGO_ROOT_PASSWORD=local-dev-mongo-password-change-me
MONGO_DB=flowmetrics

# ---- API --------------------------------------------------------------------------
# development | production. "production" makes the server refuse placeholder secrets
# containing "change-me", turns on Secure cookies, and switches to JSON logs.
APP_ENV=development

# Signs access tokens. At least 32 characters; the server will not start with less.
# Generate a real one:  openssl rand -hex 32
#   (PowerShell:  -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }) )
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789abcdef

# Access tokens are short-lived; the session itself lasts REFRESH_TOKEN_TTL. (Go duration syntax.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Must be true when the site is served over HTTPS. Leave false for http://localhost.
COOKIE_SECURE=false

# bcrypt work factor (10 = fast, 12 = recommended default, each +1 doubles the cost).
BCRYPT_COST=12

# Max login/register attempts per minute per client IP. 0 disables the limit.
AUTH_RATE_LIMIT_PER_MIN=20

# ---- Demo data --------------------------------------------------------------------
# true  = on first start, if the database has no users, create 4 demo users, 2 organizations,
#         3 projects, ~25 tasks, comments and activity (see the README for the accounts).
# false = start empty. Never enable in production: the demo accounts share a public password.
SEED_ON_START=true
# Password for the demo accounts. Empty = the documented default, Password123!
SEED_PASSWORD=

# ---- Web UI -----------------------------------------------------------------------
# Host port for the web UI (http://localhost:3000).
WEB_PORT=3000
# Build-time: show the demo accounts on the login page. Only useful with SEED_ON_START=true.
VITE_DEMO_HINT=true
